<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy to app/android/app/src/main/res/mipmap-anydpi-v26/ic_launcher.xml and
  ic_launcher_round.xml. The background is a colour rather than a bitmap so the
  launcher can move the two layers apart for its parallax effect without
  revealing a seam.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
