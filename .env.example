# Bilby environment.
#
# Copy to web/.env.local for development, or paste each value into the Vercel
# project settings for production. Never commit a filled in copy of this file:
# .gitignore blocks .env and .env.local, and that guard is the only thing
# between a secret and a public history.
#
# With NONE of these set the app still runs. It uses a local SQLite file and a
# mock supplier, which is deliberate: a fresh clone must start without an
# account anywhere.

# ── Hostnames ───────────────────────────────────────────────────────────────
# Only set these to move off the defaults. Every other hostname derives from
# APEX, so this is the one string that relocates the whole customer surface.
# NEXT_PUBLIC_APEX=bilbymobile.com
# NEXT_PUBLIC_CORP_APEX=nextwave.au

# ── Database ────────────────────────────────────────────────────────────────
# Both or neither. With neither, the app writes to .data/nesim.db locally.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Sessions ────────────────────────────────────────────────────────────────
# Two DIFFERENT random values, 32 bytes each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# They must not match. A shared key would let a customer session be replayed
# against the staff console, which is the exact thing the separate admin domain
# exists to prevent.
SESSION_SECRET=
ADMIN_SESSION_SECRET=

# The first staff account. Anyone who can read this address can request a sign
# in link, so it should be a mailbox only you control.
OWNER_EMAIL=

# ── Staff console ───────────────────────────────────────────────────────────
# Fails CLOSED when unset: /ops and /api/economics return 404 rather than
# leaking wholesale costs and margins. Never set this to a guessable value.
OPS_PASSWORD=

# ── Suppliers ───────────────────────────────────────────────────────────────
# Absent credentials mean that provider stays disabled in the registry rather
# than throwing. Enable each one from the staff console once its key is set.
ESIMACCESS_API_KEY=
AIRALO_CLIENT_ID=
AIRALO_CLIENT_SECRET=
RESELLPORTAL_API_KEY=

# ── Payments ────────────────────────────────────────────────────────────────
# Without these, checkout runs in mock mode and takes no money.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Email ───────────────────────────────────────────────────────────────────
# No key means no receipts, no eSIM delivery and no account recovery. Account
# recovery is the only route back in for a customer, because there are no
# passwords.
RESEND_API_KEY=
MAIL_FROM=hello@bilbymobile.com

# ── Monetisation, all default OFF ───────────────────────────────────────────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
# AdSense on marketing pages only. Recommended off: on a page where someone is
# about to buy, a display unit earns fractions of a cent and can hand your
# buyer to a competitor.
NEXT_PUBLIC_ADSENSE_ID=
ADMOB_APP_ID=
ADMOB_REWARDED_ID=

# ── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Legal ───────────────────────────────────────────────────────────────────
# Not printed on any page. Kept here because invoices and the Play Console
# still require it.
LEGAL_ABN=
