# Bilby, environment.
#
# Nothing here is a secret and nothing here is real. Copy to .env.local for
# local work; set the production values in Vercel, never in a file.
#
# Only the first three are needed to serve the site. Everything below them is
# off by default, and each one turns on exactly one capability when it is set.

# ---- The minimum -----------------------------------------------------------

# Supabase, Connect, Transaction pooler. The username is postgres.<project ref>,
# not postgres: the pooler finds your project from it. Percent encode any
# punctuation in the password. scripts/check-db.ts tells you which part is wrong.
DATABASE_URL=

# 32 random bytes. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Signs the cookie identifying an anonymous buyer, so rotating it after there are
# customers orphans everybody's order history.
SESSION_SECRET=change-me-to-32-random-bytes

# The first staff account, created the first time this address asks for a sign in
# link. It is a control, not a label: it decides who owns the console. Use a
# mailbox only you control, with two factor authentication on it.
OWNER_EMAIL=

# ---- Email -----------------------------------------------------------------
# Carries the console sign in links and the message telling a customer their
# plan is ready. Verify the domain in Resend first, then prove it with
# scripts/check-mail.ts, then set these. The console stops showing the sign in
# link on screen the moment the key exists, so a key that cannot send is a
# locked door. DEPLOY.md section 4 has the order.

RESEND_API_KEY=
MAIL_FROM=Bilby <hello@bilbymobile.com>

# ---- Payments --------------------------------------------------------------
# Unset, the buy button says payments are not configured rather than throwing.

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Suppliers -------------------------------------------------------------
# "mock" (default, no credentials, no money), "airalo", or "esimaccess".
PAID_SUPPLIER=mock

# The mock supplier's pretend balance, so the fulfilment path can be exercised
# end to end without an account anywhere.
MOCK_SUPPLIER_WALLET_USD=500

# Airalo Partner API. Sandbox first. https://developers.partners.airalo.com/
AIRALO_BASE_URL=https://sandbox-partners-api.airalo.com/v2
AIRALO_CLIENT_ID=
AIRALO_CLIENT_SECRET=

# eSIM Access.
ESIMACCESS_BASE_URL=https://api.esimaccess.com/api/v1/open
ESIMACCESS_ACCESS_CODE=
ESIMACCESS_SECRET_KEY=

# ---- Hostnames -------------------------------------------------------------
# Both derived from the first, and everything in the codebase follows. The
# console host is computed as <first label of the apex>.<corporate domain>,
# which today is bilbymobile.nextwave.au. Nothing writes a hostname literally.

NEXT_PUBLIC_APEX=bilbymobile.com
NEXT_PUBLIC_CORP_APEX=nextwave.au

# ---- Optional --------------------------------------------------------------

# Failures go to /console/health regardless. This mirrors them to Sentry.
SENTRY_DSN=

# The signing certificate fingerprint for Android app links, from the Play
# console. Without it the assetlinks file cannot be served.
ANDROID_CERT_SHA256=
