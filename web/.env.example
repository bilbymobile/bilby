# ---- Suppliers -------------------------------------------------------------
# "mock" (default, no credentials, no money), "airalo", or "esimaccess".
PAID_SUPPLIER=mock
FREE_SUPPLIER=mock

# Airalo Partner API — sandbox first. https://developers.partners.airalo.com/
AIRALO_BASE_URL=https://sandbox-partners-api.airalo.com/v2
AIRALO_CLIENT_ID=
AIRALO_CLIENT_SECRET=

# eSIM Access — the micro-top-up supply behind the free tier.
ESIMACCESS_BASE_URL=https://api.esimaccess.com/api/v1/open
ESIMACCESS_ACCESS_CODE=
ESIMACCESS_SECRET_KEY=

# ---- Free-tier economics ---------------------------------------------------
# starter | growth | scale | enterprise  (your supplier volume tier)
SUPPLIER_VOLUME_TIER=starter
# Rewarded views credited per user per UTC day.
DAILY_AD_CAP=10
# HARD global ceiling on free-tier data spend per UTC day, USD.
# This is a blast radius, not a growth target. Start small.
DAILY_BUDGET_USD=5
# MB a user must accrue before we transact with the supplier.
# INVARIANT: keep this <= (smallest regional mbPerAd x DAILY_AD_CAP), or users in
# your weakest region can never reach it in a single day and will churn.
REDEMPTION_THRESHOLD_MB=50

# ---- Retail ----------------------------------------------------------------
RETAIL_TARGET_MARGIN=0.45

# ---- Platform --------------------------------------------------------------
SESSION_SECRET=change-me-to-32-random-bytes
DATABASE_PATH=.data/nesim.db
MOCK_SUPPLIER_WALLET_USD=500
